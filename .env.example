# Database Configuration (PostgreSQL recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/accountapp

# Security - Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-use-openssl-rand-base64-32-chars-min

# JWT Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
APP_NAME=accountapp
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# CORS - Comma-separated list of allowed origins (NO wildcard in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760
